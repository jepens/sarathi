# Supabase Configuration
# Get these from your Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# OpenAI Configuration
# Get this from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key

# WhatsApp Business API Configuration
# Get these from https://developers.facebook.com/apps/ -> WhatsApp -> API Setup
WHATSAPP_ACCESS_TOKEN=your-system-user-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id

# Webhook Verification
# You define this string yourself and use it when configuring the webhook in Meta Dashboard
WHATSAPP_VERIFY_TOKEN=your-custom-verify-token

# Webhook Security (Optional - for production)
# Get this from https://developers.facebook.com/apps/ -> Settings -> Basic -> App Secret
WHATSAPP_APP_SECRET=your-app-secret

# Cron Job Security (Optional - for production)
# Generate a random secret for cron job authentication
CRON_SECRET=your-random-secret-string

# RajaOngkir Shipping Cost API
# Get this from https://collaborator.komerce.id -\u003e Integration -\u003e Api Key
SHIPPING_COST_KOMERCE_API_KEY=your-rajaongkir-shipping-cost-api-key
