# Supabase Configuration
# Get these from your Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI Configuration
# Get this from https://platform.openai.com/api-keys
OPENAI_API_KEY=


# WhatsApp Business API Configuration
# Get these from https://developers.facebook.com/apps/ -> WhatsApp -> API Setup
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# WhatsApp Business Account ID (WABA) — required for listing & sending
# message templates (re-engagement messages outside the 24-hour window).
# Find it in Meta Business Suite -> Business Settings -> WhatsApp Accounts.
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Webhook Verification
# You define this string yourself and use it when configuring the webhook in Meta Dashboard
WHATSAPP_VERIFY_TOKEN=

# Webhook Security (REQUIRED in production)
# Get this from https://developers.facebook.com/apps/ -> Settings -> Basic -> App Secret
# Used to verify X-Hub-Signature-256 on every inbound webhook. If not set,
# webhooks are rejected with 403 unless WHATSAPP_WEBHOOK_SKIP_SIGNATURE=true.
WHATSAPP_APP_SECRET=

# Message coalescing (debounce). Customers often send several short messages in
# a row; the bot waits this many seconds after the LAST message before replying,
# then answers the whole burst with ONE message. Prevents the "double chat" bug.
# Higher = fewer split replies but a slower bot; lower = snappier but may answer
# mid-burst. Default 60. Range 0–300 (0 disables coalescing).
WHATSAPP_DEBOUNCE_SECONDS=60

# Local-dev escape hatch: skip signature verification on the WhatsApp webhook.
# DO NOT enable in production — it lets any caller post fake webhook events.
# Leave unset (or "false") in production.
WHATSAPP_WEBHOOK_SKIP_SIGNATURE=false

# Shared secret for the queue/cron worker endpoint (/api/queue/process). The
# every-minute cron service must send it as `Authorization: Bearer <CRON_SECRET>`.
# REQUIRED in production: when unset, the endpoint refuses to run (otherwise it
# would be open to anyone to trigger queue drains + the follow-up digest).
# Generate a long random string and set the SAME value on the cron service.
CRON_SECRET=

# Follow-up digest — a once-daily WhatsApp summary of leads/bookings that need
# follow-up, sent to the owner. Piggybacks the queue cron (/api/queue/process),
# self-guarded to send once per WIB day after FOLLOWUP_DIGEST_HOUR.
# Leave FOLLOWUP_DIGEST_TO blank to disable. Requires an APPROVED Meta template
# (category Utility) with 3 body variables: {{1}} date, {{2}} lead count,
# {{3}} booking count. The owner number must be in international format (628…).
FOLLOWUP_DIGEST_TO=
FOLLOWUP_DIGEST_TEMPLATE=followup_digest
FOLLOWUP_DIGEST_LANG=id
FOLLOWUP_DIGEST_HOUR=8

# Resend — transactional email for proposal PDFs.
# Sign up at https://resend.com, verify your sender domain, then paste the API key here.
# Proposals are generated + sent by an admin from the dashboard pipeline (the AI
# never sends them autonomously). If left blank, the PDF is still generated and
# the lead is bumped to "quoted" but the email is skipped (skipped_reason returned).
RESEND_API_KEY=

# From address for proposal emails. MUST be on a domain verified in your Resend
# dashboard. For testing without a verified domain, Resend allows "onboarding@resend.dev".
# Example for production: "Nindra <nindra@sailendra.co.id>"
SAILENDRA_FROM_EMAIL=

NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Portal handoff (Phase 2 — "Buat Proposal di Portal").
# One click on a ready lead → a pre-filled DRAFT proposal in the Sailendra Event
# Portal, with the Portal client linked-or-created. Both vars are SERVER-SIDE
# ONLY (do NOT prefix with NEXT_PUBLIC) — the token is a shared secret with the
# Portal and must never reach the browser. Leave either blank to DISABLE the
# feature (the "Buat Proposal di Portal" menu item shows but stays inert).
#   PORTAL_BASE_URL    — base URL of the Portal app, e.g. https://portal.sailendra.co.id
#   PORTAL_INTAKE_TOKEN — bearer token shared with the Portal's /api/intake/* endpoints
PORTAL_BASE_URL=
PORTAL_INTAKE_TOKEN=
CRON_SECRET=

# Web Push notifications (Tier 2 — "notifikasi walau app ditutup").
# The webhook fans a browser push out to every subscribed admin device when a
# customer message arrives, so you're alerted even with the dashboard closed.
# Generate a VAPID key pair ONCE with:  npx web-push generate-vapid-keys
# Then paste the SAME public key into BOTH the public and server var (the client
# needs it to subscribe; the server needs it to sign). The private key is
# server-only — never prefix it with NEXT_PUBLIC. Leave all three blank to
# DISABLE Tier 2 (Tier 1 in-app/desktop notifications keep working).
#   NEXT_PUBLIC_VAPID_PUBLIC_KEY — public key, exposed to the browser
#   VAPID_PUBLIC_KEY             — same public key, read server-side
#   VAPID_PRIVATE_KEY           — private signing key (SECRET)
#   VAPID_SUBJECT              — contact URI, "mailto:you@domain" or an https URL
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@sailendra.co.id